NODE_ENV=production
HOST=0.0.0.0
PORT=3200
DATABASE_PATH=./data/zhusijiao.db
JWT_SECRET=replace-with-at-least-32-random-characters

# 监听地址：本机直接跑 + 本机反代用 127.0.0.1（更安全）；
# 在 Docker/1Panel 等容器里跑必须用 0.0.0.0，否则端口映射不通，反代会 502。
# HOST=127.0.0.1

# 应用更新分发目录（默认 backend/public/app；放 release.json 与 APK，见该目录 README）
# APP_FILES_DIR=./public/app

# 原生 App 的设备匿名登录（App 的正式登录方式），默认开启。
ENABLE_DEVICE_AUTH=true

# 只信任本机反向代理提供的 X-Forwarded-*，不要写 true。
TRUST_PROXY=127.0.0.1
MAX_SCHEDULES_PER_USER=30
MAX_SUBSCRIPTIONS_PER_USER=100

# 仅本地联调用的免登录接口，生产必须 false。
ENABLE_DEV_AUTH=false
LOG_LEVEL=info

# 官网域名（CORS 白名单）：配置后官网才能跨域读取 /app/release.json 获取下载链接。
# 多个域名逗号分隔；留空则与 API 同域反代部署官网（推荐）。
# SITE_ORIGINS=https://jdsk.example.com
