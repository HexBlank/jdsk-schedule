<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 主要实心按钮：一页最多一个 -->
    <style name="PrimaryButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/button_min_height</item>
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:textColor">#ffffff</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <!-- 次要描边按钮 -->
    <style name="GhostButton" parent="PrimaryButton">
        <item name="android:background">@drawable/bg_ghost_button</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="SectionTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_section</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PageTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_page_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_small</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">5dp</item>
    </style>

    <style name="FieldInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:background">@drawable/bg_field</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_disabled</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:saveEnabled">false</item>
    </style>

    <!-- 空状态卡片标题/描述 -->
    <style name="EmptyTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_subtitle</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="EmptyDesc">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_sub</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
        <item name="android:gravity">center</item>
    </style>
    <!-- 上课提醒权限检查：标题旁的状态角标（已允许/未允许/建议开启），背景和字色由代码按状态设置 -->
    <style name="ReminderStatusPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingTop">1.5dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:paddingBottom">1.5dp</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 上课提醒权限检查：行尾的「去开启/去设置」小按钮 -->
    <style name="ReminderActionButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:background">@drawable/bg_ghost_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:stateListAnimator">@animator/press_scale</item>
        <item name="android:textSize">@dimen/text_hint</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- ===== 分组列表（编辑页、设置页）：见 docs/UI_GUIDELINES.md「界面原则 · 版式」 ===== -->

    <!-- 一组行：白底细边框圆角卡片 -->
    <style name="FormGroup">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:orientation">vertical</item>
    </style>

    <!-- 一行：左字段名、右值、可点时末尾一个矢量箭头 -->
    <style name="FormRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:background">@drawable/bg_menu_row</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
    </style>

    <style name="FormGroupTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:textColor">@color/text_tertiary</item>
        <item name="android:textSize">@dimen/text_hint</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="FormRowIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <style name="FormRowLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="FormRowValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">end|center_vertical</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <style name="FormRowChevron">
        <item name="android:layout_width">16dp</item>
        <item name="android:layout_height">16dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:drawableEnd">@drawable/ic_chevron_right</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:text"></item>
    </style>

    <!-- 单选行末尾的勾：选中可见，未选中 invisible（占位不变） -->
    <style name="FormRowCheck">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">8dp</item>
        <item name="android:importantForAccessibility">no</item>
        <item name="android:text">✓</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 行内输入：无边框、占满一行，placeholder 就是字段名 -->
    <style name="FormRowInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:background">@null</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:inputType">text</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:saveEnabled">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_disabled</item>
        <item name="android:textSize">@dimen/text_body</item>
    </style>

    <!-- 页面最上方的名称输入：大一号、粗体 -->
    <style name="FormTitleInput" parent="FormRowInput">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 组内分隔：发丝线，从左内边距起 -->
    <style name="FormDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1px</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/divider</item>
    </style>

    <!-- 底部面板的标题：标题即当前值 -->
    <style name="SheetTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 底部面板的根容器：左右 18、上 8（把手上方）、下 16；所有 SheetDialog 的布局统一用它 -->
    <style name="SheetRoot">
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>

    <!-- 底部面板的把手 -->
    <style name="SheetHandle">
        <item name="android:layout_width">38dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginBottom">16dp</item>
        <item name="android:background">@drawable/bg_sheet_handle</item>
    </style>
</resources>
