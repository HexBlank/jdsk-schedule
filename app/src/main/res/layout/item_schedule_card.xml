<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/cardMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_menu_row"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="13dp"
        android:paddingEnd="13dp"
        android:paddingBottom="11dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cardName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/title_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/goneTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tag_danger"
                android:paddingStart="8dp"
                android:paddingTop="2.5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2.5dp"
                android:textColor="@color/danger"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/activeTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_tag"
                android:paddingStart="8dp"
                android:paddingTop="2.5dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2.5dp"
                android:text="@string/library_active_tag"
                android:textColor="@color/tag_text"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/cardMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/sub_6c"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/cardSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/sub_a2"
            android:textSize="11sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/foot_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="13dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/syncDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/sync_dot_green" />

            <TextView
                android:id="@+id/syncText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/sub_77"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/actionUpdate"
            style="@style/CardAction"
            android:text="@string/library_action_update" />

        <TextView
            android:id="@+id/actionShare"
            style="@style/CardAction"
            android:text="@string/library_action_share"
            android:textColor="@color/tag_text" />

        <TextView
            android:id="@+id/actionRemove"
            style="@style/CardAction"
            android:text="@string/library_action_delete"
            android:textColor="@color/danger_action" />
    </LinearLayout>
</LinearLayout>
