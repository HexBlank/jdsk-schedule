<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet" android:fillViewport="true" android:overScrollMode="never">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" style="@style/SheetRoot">
    <View style="@style/SheetHandle" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:id="@+id/holidayBack" android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_chevron_prev" android:padding="16dp" android:clickable="true" android:focusable="true"
            android:contentDescription="@string/common_back" android:background="@drawable/bg_menu_row" android:visibility="gone" />
        <TextView android:id="@+id/holidayTitle" style="@style/SheetTitle" android:layout_width="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/holidayManage" android:layout_width="wrap_content" android:layout_height="48dp"
            android:gravity="center" android:paddingStart="12dp" android:paddingEnd="8dp" android:text="@string/holiday_list_label"
            android:clickable="true" android:focusable="true" android:textSize="14sp" android:textColor="@color/text_secondary" android:background="@drawable/bg_menu_row" />
    </LinearLayout>
    <LinearLayout android:id="@+id/holidayEditorPage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <com.zhusijiao.app.ui.common.SegmentedChoiceView android:id="@+id/holidayMode"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" />
        <LinearLayout android:id="@+id/holidayFields" style="@style/FormGroup" android:layout_marginTop="16dp">
            <LinearLayout android:id="@+id/holidayFirstRow" style="@style/FormRow" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/holidayFirstLabel" style="@style/FormRowLabel" android:text="@string/holiday_start_field" />
                <TextView android:id="@+id/holidayFirstValue" style="@style/FormRowValue" />
                <TextView style="@style/FormRowChevron" />
            </LinearLayout>
            <View style="@style/FormDivider" />
            <LinearLayout android:id="@+id/holidayLastRow" style="@style/FormRow" android:clickable="true" android:focusable="true">
                <TextView android:id="@+id/holidayLastLabel" style="@style/FormRowLabel" android:text="@string/holiday_end_field" />
                <TextView android:id="@+id/holidayLastValue" style="@style/FormRowValue" />
                <TextView style="@style/FormRowChevron" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:id="@+id/holidayPreview" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:textColor="@color/text_secondary" android:textSize="14sp" android:lineSpacingExtra="4dp" />
        <TextView android:id="@+id/holidaySubmit" style="@style/PrimaryButton" android:layout_height="50dp" android:layout_marginTop="20dp" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/holidayListPage" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:overScrollMode="never" android:visibility="gone">
        <LinearLayout android:id="@+id/holidayList" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
</androidx.core.widget.NestedScrollView>
