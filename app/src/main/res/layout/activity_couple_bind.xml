<?xml version="1.0" encoding="utf-8"?>
<!-- 绑定情侣课表：一方生成邀请码，另一方输入。邀请码与分享码同一套 8 位字符。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.zhusijiao.app.ui.common.AppHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="24dp">

            <TextView
                style="@style/PageTitle"
                android:layout_marginTop="20dp"
                android:text="@string/couple_bind_heading" />

            <TextView
                style="@style/PageSubtitle"
                android:layout_marginTop="7dp"
                android:text="@string/couple_bind_desc" />

            <!-- 邀请 TA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="16dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/couple_invite_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/couple_invite_desc"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/inviteChars"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/inviteMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/sub_8a"
                    android:textSize="11.5sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/inviteWaiting"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/couple_invite_waiting"
                    android:textColor="@color/accent_strong"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/inviteActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/copyInvite"
                        style="@style/GhostButton"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/couple_invite_copy" />

                    <TextView
                        android:id="@+id/shareInvite"
                        style="@style/PrimaryButton"
                        android:layout_width="0dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/couple_invite_share" />
                </LinearLayout>

                <TextView
                    android:id="@+id/inviteButton"
                    style="@style/GhostButton"
                    android:layout_marginTop="12dp"
                    android:text="@string/couple_invite_generate" />
            </LinearLayout>

            <!-- 输入 TA 的邀请码 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="16dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <TextView
                    style="@style/SectionTitle"
                    android:text="@string/couple_accept_title" />

                <FrameLayout
                    android:id="@+id/codeField"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:id="@+id/codeCells"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />

                    <EditText
                        android:id="@+id/codeInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:cursorVisible="false"
                        android:hint="@string/couple_accept_title"
                        android:importantForAutofill="no"
                        android:inputType="textCapCharacters|textNoSuggestions"
                        android:maxLength="8"
                        android:singleLine="true"
                        android:textColor="@android:color/transparent"
                        android:textColorHint="@android:color/transparent"
                        android:textSize="16sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/pasteBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_menu_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="11dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="6dp"
                    android:text="@string/couple_accept_paste"
                    android:textColor="@color/accent_strong"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/errorNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_error_note"
                    android:gravity="center"
                    android:padding="10dp"
                    android:textColor="@color/danger"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/acceptButton"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="14dp"
                    android:text="@string/couple_accept_button" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_privacy_note"
                android:lineSpacingMultiplier="1.4"
                android:padding="12dp"
                android:text="@string/couple_bind_privacy"
                android:textColor="@color/field_label"
                android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
