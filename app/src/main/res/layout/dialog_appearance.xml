<?xml version="1.0" encoding="utf-8"?>
<!--
  课表外观面板：只占屏幕下半部分，背景几乎不压暗（SheetDialog.SCRIM_CLEAR），
  用户一边点档位一边能看到上半屏真实课表的变化，因此没有「确定」按钮——改一下即时生效。
  分「尺寸」「显示」两页，一页只摆三四个控件；页签就是面板标题。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    style="@style/SheetRoot">

    <View
        style="@style/SheetHandle"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/appearanceTabSize"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingEnd="20dp"
            android:text="@string/appearance_tab_size"
            android:textSize="@dimen/text_subtitle"
            tools:ignore="RtlSymmetry" />

        <TextView
            android:id="@+id/appearanceTabDisplay"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:paddingEnd="20dp"
            android:text="@string/appearance_tab_display"
            android:textSize="@dimen/text_subtitle"
            tools:ignore="RtlSymmetry" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/appearanceReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/appearance_reset"
            android:textColor="@color/accent_strong"
            android:textSize="@dimen/text_hint" />
    </LinearLayout>

    <!-- 小屏或系统大字体下内容仍可能超出，这里限高可滚 -->
    <com.zhusijiao.app.ui.common.MaxHeightScrollView
        android:id="@+id/appearanceScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- 两页叠放，不在的那页 invisible 而不是 gone：面板高度不随换页跳动 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- 尺寸 -->
            <LinearLayout
                android:id="@+id/appearancePageSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/appearance_row_height"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_hint" />

                <com.zhusijiao.app.ui.common.SegmentedChoiceView
                    android:id="@+id/heightChoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <!-- 整行可点只是放大触摸区；真正的焦点/无障碍控件是行内的 ToggleView -->
                <LinearLayout
                    android:id="@+id/fitScreenRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    tools:ignore="KeyboardInaccessibleWidget">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/appearance_fit_screen"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                    <com.zhusijiao.app.ui.common.ToggleView
                        android:id="@+id/fitScreenToggle"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/appearance_fit_screen" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/appearance_padding"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_hint" />

                <com.zhusijiao.app.ui.common.SegmentedChoiceView
                    android:id="@+id/paddingChoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/appearance_text_size"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_hint" />

                <com.zhusijiao.app.ui.common.SegmentedChoiceView
                    android:id="@+id/textChoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- 显示 -->
            <LinearLayout
                android:id="@+id/appearancePageDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="invisible">

                <LinearLayout
                    android:id="@+id/showNextClassRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    tools:ignore="KeyboardInaccessibleWidget">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/appearance_show_next_class"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                    <com.zhusijiao.app.ui.common.ToggleView
                        android:id="@+id/showNextClassToggle"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/appearance_show_next_class" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/showNowLineRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    tools:ignore="KeyboardInaccessibleWidget">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/appearance_show_now_line"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                    <com.zhusijiao.app.ui.common.ToggleView
                        android:id="@+id/showNowLineToggle"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/appearance_show_now_line" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/showFinishedRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    tools:ignore="KeyboardInaccessibleWidget">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/appearance_show_finished"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                    <com.zhusijiao.app.ui.common.ToggleView
                        android:id="@+id/showFinishedToggle"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/appearance_show_finished" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/weekendAutoRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="false"
                    android:gravity="center_vertical"
                    android:importantForAccessibility="no"
                    android:minHeight="52dp"
                    android:orientation="horizontal"
                    tools:ignore="KeyboardInaccessibleWidget">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/week_picker_auto_weekend"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                    <com.zhusijiao.app.ui.common.ToggleView
                        android:id="@+id/weekendAutoToggle"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/week_picker_auto_weekend" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/appearance_state_style"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_hint" />

                <!-- 二选一的预览卡片：看图选，而不是一个说不清的「使用旧样式」开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/stateStyleModern"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <com.zhusijiao.app.ui.common.StateStylePreviewView
                            android:id="@+id/stateStyleModernPreview"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:importantForAccessibility="no"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/stateStyleModernRadio"
                                android:layout_width="14dp"
                                android:layout_height="14dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:text="@string/appearance_state_modern"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_small"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/stateStyleClassic"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="8dp">

                        <com.zhusijiao.app.ui.common.StateStylePreviewView
                            android:id="@+id/stateStyleClassicPreview"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:importantForAccessibility="no" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:importantForAccessibility="no"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/stateStyleClassicRadio"
                                android:layout_width="14dp"
                                android:layout_height="14dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="7dp"
                                android:text="@string/appearance_state_classic"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_small"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>
    </com.zhusijiao.app.ui.common.MaxHeightScrollView>
</LinearLayout>
