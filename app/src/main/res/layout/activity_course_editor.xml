<?xml version="1.0" encoding="utf-8"?>
<!-- 添加 / 修改自己加的课：名称是唯一要填的，时间和周次已按点的格子给好默认值，想改再点 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.zhusijiao.app.ui.common.AppHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="24dp">

            <LinearLayout style="@style/FormGroup">

                <EditText
                    android:id="@+id/courseName"
                    style="@style/FormTitleInput"
                    android:inputType="text"
                    android:importantForAutofill="no"
                    android:hint="@string/course_name_hint"
                    android:imeOptions="actionDone"
                    android:maxLength="40" />
            </LinearLayout>

            <LinearLayout
                style="@style/FormGroup"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/courseTimeRow"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/form_time" />

                    <TextView
                        android:id="@+id/courseTimeValue"
                        style="@style/FormRowValue" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/courseWeeksRow"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/form_weeks" />

                    <TextView
                        android:id="@+id/courseWeeksValue"
                        style="@style/FormRowValue" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/FormGroup"
                android:layout_marginTop="16dp">

                <EditText
                    android:id="@+id/coursePosition"
                    style="@style/FormRowInput"
                    android:importantForAutofill="no"
                    android:hint="@string/course_position_hint"
                    android:maxLength="40" />

                <View style="@style/FormDivider" />

                <EditText
                    android:id="@+id/courseTeacher"
                    style="@style/FormRowInput"
                    android:importantForAutofill="no"
                    android:hint="@string/course_teacher_hint"
                    android:maxLength="30" />

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/courseColorRow"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/event_color_label" />

                    <View
                        android:id="@+id/courseColorSwatch"
                        android:layout_width="22dp"
                        android:layout_height="22dp" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- 只在真的和别的课重叠时出现一行；不拦保存，课表上会并排显示 -->
            <TextView
                android:id="@+id/courseConflict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/warn"
                android:textSize="@dimen/text_small"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/courseSave"
            style="@style/PrimaryButton"
            android:minHeight="48dp"
            android:text="@string/course_save" />
    </LinearLayout>
</LinearLayout>
