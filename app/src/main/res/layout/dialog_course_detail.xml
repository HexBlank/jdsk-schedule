<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="8dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="13dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="14dp">

        <View
            android:id="@+id/sheetAccent"
            android:layout_width="4dp"
            android:layout_height="42dp"
            android:layout_marginEnd="11dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/sheetTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/heading_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/sheetSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/sub_8a"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/detail_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="11dp"
        android:paddingBottom="11dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="@string/detail_weeks"
            android:textColor="@color/detail_label"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/sheetWeeks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/body_ink"
            android:textSize="13.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="11dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="@string/detail_time"
            android:textColor="@color/detail_label"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/sheetTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/body_ink"
            android:textSize="13.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="11dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="@string/detail_room"
            android:textColor="@color/detail_label"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/sheetRoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/body_ink"
            android:textSize="13.5sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="@string/detail_teacher"
            android:textColor="@color/detail_label"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/sheetTeacher"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/body_ink"
            android:textSize="13.5sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sheetAdjustment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/tt_section_bg"
        android:padding="11dp"
        android:textColor="@color/body_ink"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sheetReadOnly"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/tt_section_bg"
        android:padding="11dp"
        android:text="@string/detail_read_only_hint"
        android:textColor="@color/sub_8a"
        android:textSize="12.5sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sheetReschedule"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_close_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/reschedule_action"
        android:textColor="@color/sheet_close_text"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sheetUndo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/reschedule_undo"
        android:textColor="@color/sub_8a"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sheetClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="@string/detail_done"
        android:textColor="@color/sub_8a"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
