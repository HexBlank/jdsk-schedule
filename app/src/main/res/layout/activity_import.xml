<?xml version="1.0" encoding="utf-8"?>
<!--
  导入课表分两步，一屏只做一件事：
  1. 选来源：教务系统是主路径（实心按钮），文件、剪贴板、手动粘贴和帮助都是行；
  2. 识别出来后整页换成结果：来源一行（可重选）、课程预览、导入到哪里、名称 / 第 1 周 / 总周数，保存钉在底部。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.zhusijiao.app.ui.common.AppHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="24dp">

            <!-- ===== 第一步：选来源 ===== -->
            <LinearLayout
                android:id="@+id/sourceSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    style="@style/FormGroup"
                    android:layout_marginTop="4dp"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/eamsBtn"
                        style="@style/PrimaryButton"
                        android:minHeight="48dp"
                        android:text="@string/import_from_eams" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center"
                        android:text="@string/import_steps_summary"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    style="@style/FormGroup"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:id="@+id/fileBtn"
                        style="@style/FormRow"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            style="@style/FormRowLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/import_choose_file" />

                        <TextView style="@style/FormRowChevron" />
                    </LinearLayout>

                    <View style="@style/FormDivider" />

                    <LinearLayout
                        android:id="@+id/clipBtn"
                        style="@style/FormRow"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            style="@style/FormRowLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/import_read_clipboard" />

                        <TextView style="@style/FormRowChevron" />
                    </LinearLayout>

                    <View style="@style/FormDivider" />

                    <LinearLayout
                        android:id="@+id/pasteRow"
                        style="@style/FormRow"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            style="@style/FormRowLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/import_paste_row" />

                        <TextView style="@style/FormRowChevron" />
                    </LinearLayout>

                    <!-- 手动粘贴：点了上面那行才展开 -->
                    <LinearLayout
                        android:id="@+id/pasteArea"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View style="@style/FormDivider" />

                        <EditText
                            android:id="@+id/sourceInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:gravity="top|start"
                            android:hint="@string/import_paste_hint"
                            android:importantForAutofill="no"
                            android:inputType="textMultiLine"
                            android:maxLines="8"
                            android:minHeight="120dp"
                            android:paddingStart="14dp"
                            android:paddingTop="12dp"
                            android:paddingEnd="14dp"
                            android:paddingBottom="12dp"
                            android:saveEnabled="false"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_disabled"
                            android:textSize="@dimen/text_small" />

                        <TextView
                            android:id="@+id/parseBtn"
                            style="@style/PrimaryButton"
                            android:layout_width="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginEnd="12dp"
                            android:layout_marginBottom="12dp"
                            android:minHeight="40dp"
                            android:minWidth="96dp"
                            android:text="@string/import_parse"
                            android:textSize="@dimen/text_body" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/FormGroup"
                    android:layout_marginTop="20dp">

                    <LinearLayout
                        android:id="@+id/guideBtn"
                        style="@style/FormRow"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            style="@style/FormRowLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/import_show_guide" />

                        <TextView style="@style/FormRowChevron" />
                    </LinearLayout>

                    <View style="@style/FormDivider" />

                    <LinearLayout
                        android:id="@+id/copyHelperBtn"
                        style="@style/FormRow"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            style="@style/FormRowLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/import_copy_helper" />

                        <TextView style="@style/FormRowChevron" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 第二步：识别结果与保存 ===== -->
            <LinearLayout
                android:id="@+id/resultSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 来源：名称是值，点整行回到第一步重选 -->
                <LinearLayout style="@style/FormGroup">

                    <LinearLayout
                        android:id="@+id/sourceRow"
                        style="@style/FormRow"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/sourceName"
                            style="@style/FormRowLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1" />

                        <TextView
                            style="@style/FormRowValue"
                            android:layout_width="wrap_content"
                            android:layout_weight="0"
                            android:text="@string/import_reselect" />

                        <TextView style="@style/FormRowChevron" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/resultCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_hint" />

                <LinearLayout
                    android:id="@+id/coursePreview"
                    style="@style/FormGroup" />

                <!-- JSON 备份：课程以外还会一并恢复的内容（值），没有就不显示 -->
                <TextView
                    android:id="@+id/backupNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_hint"
                    android:visibility="gone" />

                <!-- 导入到哪里：只有能覆盖的课表时才出现，两行勾选 -->
                <LinearLayout
                    android:id="@+id/targetGroup"
                    style="@style/FormGroup"
                    android:layout_marginTop="20dp"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/overwriteRow"
                        style="@style/FormRow"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/overwriteText"
                            style="@style/FormRowLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1" />

                        <TextView
                            android:id="@+id/overwriteCheck"
                            style="@style/FormRowCheck" />
                    </LinearLayout>

                    <!-- 后果：覆盖会删掉手动调课时才出现 -->
                    <TextView
                        android:id="@+id/overwriteWarning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-6dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingBottom="10dp"
                        android:textColor="@color/warn"
                        android:textSize="@dimen/text_hint"
                        android:visibility="gone" />

                    <View style="@style/FormDivider" />

                    <LinearLayout
                        android:id="@+id/newRow"
                        style="@style/FormRow"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            style="@style/FormRowLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/import_mode_new" />

                        <TextView
                            android:id="@+id/newCheck"
                            style="@style/FormRowCheck" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    style="@style/FormGroup"
                    android:layout_marginTop="20dp">

                    <LinearLayout style="@style/FormRow">

                        <TextView
                            style="@style/FormRowLabel"
                            android:text="@string/import_name_label" />

                        <EditText
                            android:id="@+id/nameInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@null"
                            android:gravity="end|center_vertical"
                            android:hint="@string/import_name_label"
                            android:importantForAutofill="no"
                            android:inputType="text"
                            android:maxLength="40"
                            android:minHeight="36dp"
                            android:saveEnabled="false"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_disabled"
                            android:textSize="@dimen/text_body" />
                    </LinearLayout>

                    <View style="@style/FormDivider" />

                    <LinearLayout
                        android:id="@+id/datePicker"
                        style="@style/FormRow"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            style="@style/FormRowLabel"
                            android:text="@string/import_date_label" />

                        <TextView
                            android:id="@+id/dateValue"
                            style="@style/FormRowValue" />

                        <TextView style="@style/FormRowChevron" />
                    </LinearLayout>

                    <View style="@style/FormDivider" />

                    <LinearLayout style="@style/FormRow">

                        <TextView
                            style="@style/FormRowLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="@string/import_weeks_label" />

                        <com.zhusijiao.app.ui.common.StepperFieldView
                            android:id="@+id/weeksStepper"
                            android:layout_width="150dp"
                            android:layout_height="40dp"
                            android:contentDescription="@string/import_weeks_label" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/saveBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/saveBtn"
            style="@style/PrimaryButton"
            android:minHeight="48dp"
            android:text="@string/import_save_new" />
    </LinearLayout>
</LinearLayout>
