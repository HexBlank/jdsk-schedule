<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.zhusijiao.app.ui.common.AppHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="24dp">

            <TextView
                style="@style/PageSubtitle"
                android:layout_marginTop="4dp"
                android:text="@string/import_intro" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_privacy_note"
                android:lineSpacingMultiplier="1.3"
                android:paddingStart="9dp"
                android:paddingTop="8dp"
                android:paddingEnd="9dp"
                android:paddingBottom="8dp"
                android:text="@string/import_privacy_note"
                android:textColor="@color/privacy_note_text"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/eamsBtn"
                style="@style/PrimaryButton"
                android:layout_marginTop="13dp"
                android:text="@string/import_from_eams" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/fileBtn"
                    style="@style/GhostButton"
                    android:layout_width="0dp"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:text="@string/import_choose_file" />

                <TextView
                    android:id="@+id/clipBtn"
                    style="@style/GhostButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/import_read_clipboard" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/guideBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_menu_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="@string/import_show_guide"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/copyHelperBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_menu_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="8dp"
                    android:text="@string/import_copy_helper"
                    android:textColor="@color/accent"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fileInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:background="@drawable/bg_file_info"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="9dp"
                android:paddingTop="8dp"
                android:paddingEnd="9dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/fileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/sub_3e"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/fileChars"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/sub_8a"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                style="@style/FieldLabel"
                android:text="@string/import_paste_label" />

            <EditText
                android:id="@+id/sourceInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:gravity="top|start"
                android:hint="@string/import_paste_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minHeight="110dp"
                android:paddingStart="11dp"
                android:paddingTop="10dp"
                android:paddingEnd="11dp"
                android:paddingBottom="10dp"
                android:saveEnabled="false"
                android:textColor="@color/ink"
                android:textColorHint="@color/sub_a0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/parseBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:minWidth="95dp"
                android:paddingStart="14dp"
                android:paddingTop="9dp"
                android:paddingEnd="14dp"
                android:paddingBottom="9dp"
                android:gravity="center"
                android:text="@string/import_parse"
                android:textColor="#ffffff"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/resultSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="21dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/import_result" />

                    <TextView
                        android:id="@+id/resultCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/sub_8a"
                        android:textSize="11sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/coursePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical" />

                <RadioGroup
                    android:id="@+id/importModeSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/import_mode_title"
                        android:textColor="@color/heading_ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <RadioButton
                        android:id="@+id/overwriteMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:minHeight="48dp"
                        android:text="@string/import_mode_overwrite_loading"
                        android:textColor="@color/body_ink"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/overwriteWarning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_marginBottom="4dp"
                        android:text="@string/import_mode_overwrite_desc"
                        android:textColor="@color/sub_8a"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <RadioButton
                        android:id="@+id/newMode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/import_mode_new"
                        android:textColor="@color/body_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:text="@string/import_mode_new_desc"
                        android:textColor="@color/sub_8a"
                        android:textSize="11sp" />
                </RadioGroup>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingStart="11dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="11dp"
                    android:paddingBottom="12dp">

                    <TextView
                        style="@style/FieldLabel"
                        android:layout_marginTop="10dp"
                        android:text="@string/import_name_label" />

                    <EditText
                        android:id="@+id/nameInput"
                        style="@style/FieldInput"
                        android:hint="@string/import_name_hint"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLength="40"
                        android:singleLine="true" />

                    <TextView
                        style="@style/FieldLabel"
                        android:text="@string/import_date_label" />

                    <TextView
                        android:id="@+id/datePicker"
                        style="@style/FieldInput"
                        android:clickable="true"
                        android:focusable="true"
                        android:text="@string/import_date_hint"
                        android:textColor="@color/sub_a0" />

                    <TextView
                        style="@style/FieldLabel"
                        android:text="@string/import_weeks_label" />

                    <EditText
                        android:id="@+id/weeksInput"
                        style="@style/FieldInput"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="2"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/saveBtn"
                    style="@style/PrimaryButton"
                    android:layout_marginTop="11dp"
                    android:text="@string/import_save" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
