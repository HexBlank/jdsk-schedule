    android:orientation="vertical"
    style="@style/SheetRoot">

    <View style="@style/SheetHandle" />

    <TextView
        android:id="@+id/addEntryTitle"
        style="@style/SheetTitle" />

    <include layout="@layout/include_add_entry_choices" />
</LinearLayout>
