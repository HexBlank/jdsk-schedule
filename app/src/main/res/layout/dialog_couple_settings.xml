<?xml version="1.0" encoding="utf-8"?>
<!-- 情侣课表设置：「我们」页右上角进入。显示开关只影响本机；名字颜色与解绑影响双方。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="8dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="13dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/couple_settings_title"
        android:textColor="@color/heading_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <com.zhusijiao.app.ui.common.MaxHeightScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/couple_settings_display"
                android:textColor="@color/field_label"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- 整行可点只是放大触摸区；真正的焦点/无障碍控件是行内的 ToggleView -->
            <LinearLayout
                android:id="@+id/nowLineRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                tools:ignore="KeyboardInaccessibleWidget">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/couple_setting_now_line"
                        android:textColor="@color/body_ink"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/couple_setting_now_line_sub"
                        android:textColor="@color/sub_a8"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.zhusijiao.app.ui.common.ToggleView
                    android:id="@+id/nowLineToggle"
                    android:layout_width="50dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/couple_setting_now_line" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/detail_border" />

            <!-- 整行可点只是放大触摸区；真正的焦点/无障碍控件是行内的 ToggleView -->
            <LinearLayout
                android:id="@+id/highlightRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                tools:ignore="KeyboardInaccessibleWidget">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/couple_setting_highlight"
                        android:textColor="@color/body_ink"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/couple_setting_highlight_sub"
                        android:textColor="@color/sub_a8"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.zhusijiao.app.ui.common.ToggleView
                    android:id="@+id/highlightToggle"
                    android:layout_width="50dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/couple_setting_highlight" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/detail_border" />

            <!-- 整行可点只是放大触摸区；真正的焦点/无障碍控件是行内的 ToggleView -->
            <LinearLayout
                android:id="@+id/freeLabelRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                tools:ignore="KeyboardInaccessibleWidget">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/couple_setting_free_label"
                        android:textColor="@color/body_ink"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/couple_setting_free_label_sub"
                        android:textColor="@color/sub_a8"
                        android:textSize="11sp" />
                </LinearLayout>

                <com.zhusijiao.app.ui.common.ToggleView
                    android:id="@+id/freeLabelToggle"
                    android:layout_width="50dp"
                    android:layout_height="32dp"
                    android:contentDescription="@string/couple_setting_free_label" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/detail_border" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/couple_settings_binding"
                android:textColor="@color/field_label"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/profileRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/couple_setting_profile"
                    android:textColor="@color/body_ink"
                    android:textSize="13.5sp" />

                <View
                    android:id="@+id/profileSwatchMe"
                    android:layout_width="12dp"
                    android:layout_height="12dp" />

                <View
                    android:id="@+id/profileSwatchPartner"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="5dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="›"
                    android:textColor="@color/arrow_grey"
                    android:textSize="18sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/detail_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/couple_setting_schedule"
                        android:textColor="@color/body_ink"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/scheduleValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="end"
                        android:maxLines="1"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/couple_setting_schedule_hint"
                    android:textColor="@color/sub_a8"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/syncedValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/sub_a8"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/detail_border" />

            <TextView
                android:id="@+id/unbindRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_menu_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="52dp"
                android:text="@string/couple_unbind"
                android:textColor="@color/danger"
                android:textSize="13.5sp" />
        </LinearLayout>
    </com.zhusijiao.app.ui.common.MaxHeightScrollView>
</LinearLayout>
