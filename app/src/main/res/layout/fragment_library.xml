<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.zhusijiao.app.ui.common.AppHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="16dp">

            <TextView
                style="@style/PageSubtitle"
                android:layout_marginTop="4dp"
                android:text="@string/library_intro" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/importBtn"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="@string/library_import" />

                <TextView
                    android:id="@+id/joinBtn"
                    style="@style/GhostButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/library_join" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/library_all" />

                <TextView
                    android:id="@+id/countText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/sub_8a"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/skeletonList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="94dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="94dp"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="36dp"
                android:paddingEnd="16dp"
                android:paddingBottom="36dp"
                android:visibility="gone">

                <TextView
                    style="@style/EmptyTitle"
                    android:text="@string/library_empty_title" />

                <TextView
                    style="@style/EmptyDesc"
                    android:layout_marginBottom="0dp"
                    android:text="@string/library_empty_desc" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
