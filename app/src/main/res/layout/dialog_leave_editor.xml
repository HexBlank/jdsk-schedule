<?xml version="1.0" encoding="utf-8"?>
<!-- 请假编辑：类别、起止时刻（精确到分钟、可跨天）、事由，下面实时列出这段时间涉及的课 -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <View
            android:layout_width="38dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="15dp"
            android:background="@drawable/bg_sheet_handle" />

        <TextView
            android:id="@+id/leaveEditorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textColor="@color/heading_ink"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingMultiplier="1.35"
            android:text="@string/leave_editor_desc"
            android:textColor="@color/sub_8a"
            android:textSize="@dimen/text_hint" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/leave_type_label"
            android:textColor="@color/field_label"
            android:textSize="@dimen/text_hint"
            android:textStyle="bold" />

        <com.zhusijiao.app.ui.common.SegmentedChoiceView
            android:id="@+id/leaveType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/leave_span_label"
                android:textColor="@color/field_label"
                android:textSize="@dimen/text_hint"
                android:textStyle="bold" />

            <!-- 请一整天或连着几天：一下把起止对齐到 00:00 和 23:59 -->
            <TextView
                android:id="@+id/leaveWholeDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="28dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/leave_whole_day"
                android:textColor="@color/accent_strong"
                android:textSize="@dimen/text_hint" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/leaveStartRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/leave_start_label"
                android:textColor="@color/sub_8a"
                android:textSize="@dimen/text_small" />

            <TextView
                android:id="@+id/leaveStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="›"
                android:textColor="@color/arrow_grey"
                android:textSize="@dimen/text_title" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/leaveEndRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/leave_end_label"
                android:textColor="@color/sub_8a"
                android:textSize="@dimen/text_small" />

            <TextView
                android:id="@+id/leaveEnd"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="›"
                android:textColor="@color/arrow_grey"
                android:textSize="@dimen/text_title" />
        </LinearLayout>

        <TextView
            android:id="@+id/leaveError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/danger"
            android:textSize="@dimen/text_hint"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/leave_note_label"
            android:textColor="@color/field_label"
            android:textSize="@dimen/text_hint"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/leaveNote"
            style="@style/FieldInput"
            android:layout_marginTop="6dp"
            android:hint="@string/leave_note_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="60"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_detail_cell"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="11dp">

            <TextView
                android:id="@+id/leavePreviewLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/accent_strong"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/leavePreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingMultiplier="1.4"
                android:textColor="@color/body_ink"
                android:textSize="@dimen/text_small" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/leaveDelete"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_danger_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/leave_delete"
                android:textColor="@color/danger_action"
                android:textSize="@dimen/text_button"
                android:visibility="gone" />

            <TextView
                android:id="@+id/leaveSave"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:text="@string/leave_save" />
        </LinearLayout>

        <TextView
            android:id="@+id/leaveCancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_menu_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/common_cancel"
            android:textColor="@color/sub_68"
            android:textSize="@dimen/text_body" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
