<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/FormRow" android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/actionRowIcon" android:layout_width="22dp" android:layout_height="22dp"
        android:layout_marginEnd="14dp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/actionRowLabel" android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:textSize="@dimen/text_body" android:textColor="@color/text_primary"
        android:importantForAccessibility="no" />
    <ImageView android:id="@+id/actionRowCheck" android:layout_width="22dp" android:layout_height="22dp"
        android:layout_marginStart="8dp" android:src="@drawable/ic_menu_check"
        android:importantForAccessibility="no" android:visibility="invisible" />
</LinearLayout>
