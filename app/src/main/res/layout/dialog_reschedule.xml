<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rescheduleScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_sheet"
        android:orientation="vertical"
        style="@style/SheetRoot">

        <View style="@style/SheetHandle" />

        <TextView
            android:id="@+id/rescheduleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/reschedule_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/reschedule_source_label"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_hint"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rescheduleSource"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_reschedule_source"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_small" />

        <!-- 目标日期：整学期日历直选（与调休面板同一个控件），
             替代旧版「目标周次胶囊行 + 目标星期分段」两行抽象输入。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="6dp"
            android:text="@string/reschedule_date_label"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_hint"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/rescheduleCalendarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="10dp">

            <include layout="@layout/include_calendar_weekdays" />
            <androidx.core.widget.NestedScrollView android:id="@+id/rescheduleCalendarScroll"
                android:layout_width="match_parent" android:layout_height="280dp" android:overScrollMode="never">
                <com.zhusijiao.app.ui.common.HolidayCalendarView
                    android:id="@+id/rescheduleCalendar" android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/rescheduleNoCalendar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/tt_section_bg"
            android:padding="11dp"
            android:text="@string/reschedule_no_calendar"
            android:textColor="@color/text_tertiary"
            android:textSize="@dimen/text_small"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="6dp"
            android:text="@string/reschedule_section"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_hint"
            android:textStyle="bold" />

        <com.zhusijiao.app.ui.common.ChipRowView
            android:id="@+id/rescheduleSectionChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:contentDescription="@string/reschedule_section" />


        <EditText
            android:id="@+id/rescheduleRoom"
            style="@style/FieldInput"
            android:layout_height="50dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="@null"
            android:hint="@string/reschedule_room_hint"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLength="80"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_reschedule_summary"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reschedule_summary_label"
                android:textColor="@color/accent_strong"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/rescheduleSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/rescheduleSave"
            style="@style/PrimaryButton"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:text="@string/reschedule_save" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
