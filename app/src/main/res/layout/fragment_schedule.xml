<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!--
      首页顶栏：有课表时左侧是清晰的「第 N 周 ▾」+ 日期与课表名，翻到别的周时旁侧出现「回本周」；
      右侧是「周 / 日」胶囊切换与「⋯」更多操作。不在顶栏或底栏放常驻新建课表入口（低频，只在空状态/课表库出现）。
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false">

        <com.zhusijiao.app.ui.common.AppHeader
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:id="@+id/weekBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <!-- 左侧：第 N 周 ▾ + 日期与课表名 -->
            <LinearLayout
                android:id="@+id/weekCenter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_menu_row"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/weekTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginStart="5dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_caret_down" />

                    <TextView
                        android:id="@+id/backToCurrentWeek"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_tag"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="@string/index_back_current_week"
                        android:textColor="@color/accent_strong"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/weekCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/text_tertiary"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <!-- 右侧：周 / 日 胶囊切换 -->
            <LinearLayout
                android:id="@+id/viewModeSegment"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_segment_track"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/modeWeekBtn"
                    android:layout_width="34dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="@string/couple_view_week_desc"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/couple_view_week"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_hint"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/modeDayBtn"
                    android:layout_width="34dp"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="@string/couple_view_day_desc"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/couple_view_day"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_hint" />
            </LinearLayout>

            <!-- 更多操作按钮（与 AppHeader 右侧留出等宽空间，避免重叠加触摸） -->
            <ImageView
                android:id="@+id/weekMoreBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_menu_row"
                android:clickable="true"
                android:contentDescription="@string/library_more"
                android:focusable="true"
                android:scaleType="center"
                android:src="@drawable/ic_more" />
        </LinearLayout>
    </FrameLayout>

    <!-- 下一节课焦点卡片：仅在周视图、本周今天还有课时出现；双行结构不截断教室，无多余竖条 -->
    <LinearLayout
        android:id="@+id/nextClassBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_next_class"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nextClassTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/nextClassSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_hint" />
        </LinearLayout>

        <TextView
            android:id="@+id/nextClassTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_tag"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textColor="@color/accent_strong"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 内容区：周视图 / 日视图 / 加载 / 空 / 错误态 -->
    <FrameLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ===== 周视图 ===== -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/surface"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.zhusijiao.app.ui.common.TimetableView
                    android:id="@+id/timetable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- ===== 今日视图（日视图） ===== -->
        <LinearLayout
            android:id="@+id/dayViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- 本周七天快速切换条 -->
            <LinearLayout
                android:id="@+id/dayStrip"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:background="@color/background"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp" />

            <androidx.core.widget.NestedScrollView
                android:id="@+id/dayScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/page_padding"
                    android:paddingTop="6dp"
                    android:paddingEnd="@dimen/page_padding"
                    android:paddingBottom="16dp">

                    <LinearLayout
                        android:id="@+id/dayCardList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <LinearLayout
                        android:id="@+id/dayEmptyCard"
                        style="@style/FormGroup"
                        android:layout_marginTop="24dp"
                        android:gravity="center_horizontal"
                        android:paddingTop="40dp"
                        android:paddingBottom="40dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/dayEmptyTitle"
                            style="@style/EmptyTitle"
                            android:text="@string/day_view_empty" />

                        <TextView
                            android:id="@+id/dayEmptySub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:textColor="@color/text_tertiary"
                            android:textSize="@dimen/text_hint"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <TextView
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/index_loading"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_small"
            android:visibility="gone" />

        <!-- 还没有课表：只在无课表时呈现导入/加入入口 -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="16dp"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginBottom="18dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher_round" />

            <TextView
                style="@style/EmptyTitle"
                android:text="@string/index_empty_title" />

            <TextView
                android:id="@+id/emptyImport"
                style="@style/PrimaryButton"
                android:layout_marginTop="22dp"
                android:minHeight="48dp"
                android:text="@string/index_import" />

            <TextView
                android:id="@+id/emptyJoin"
                style="@style/GhostButton"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:text="@string/join_title" />
        </LinearLayout>

        <!-- 加载失败 -->
        <LinearLayout
            android:id="@+id/errorState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="16dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="36dp"
            android:paddingEnd="16dp"
            android:paddingBottom="36dp"
            android:visibility="gone">

            <TextView
                style="@style/EmptyTitle"
                android:text="@string/index_load_failed_title" />

            <TextView
                android:id="@+id/errorMessage"
                style="@style/EmptyDesc" />

            <TextView
                android:id="@+id/errorRetry"
                style="@style/PrimaryButton"
                android:text="@string/common_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
