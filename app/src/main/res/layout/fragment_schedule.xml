<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!--
      页头与周次栏合成一行：正中「第 N 周 ▾」（点开选周）+ 一行日期范围与课表名，
      左侧在翻到别的周时出现「回本周」，右侧是页头自己的「⋯」。翻周靠左右滑课表，不再放箭头。
      周次栏叠在页头的 48dp 内容行上；它自己不可点，空白处的触摸会落到下面的页头按钮上。
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.zhusijiao.app.ui.common.AppHeader
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <FrameLayout
            android:id="@+id/weekBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/weekCenter"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_menu_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- 与右侧 caret 等宽的占位，保证「第 N 周」文字与下方那行同轴居中 -->
                    <View
                        android:layout_width="15dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/weekTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/title_ink"
                        android:textSize="@dimen/text_nav_title"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginStart="6dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_caret_down" />
                </LinearLayout>

                <TextView
                    android:id="@+id/weekCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/tt_week_hint"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <!-- 与「我们」页的「回今天」同款胶囊 -->
            <TextView
                android:id="@+id/backToCurrentWeek"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_tag"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:minHeight="32dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/index_back_current_week"
                android:textColor="@color/accent_strong"
                android:textSize="@dimen/text_hint"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <!-- 下一节课提示条：只在本周、今天还有课时出现，点开是那节课的详情 -->
    <LinearLayout
        android:id="@+id/nextClassBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_next_class"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="38dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <View
            android:id="@+id/nextClassDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/nextClassLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/accent_strong"
            android:textSize="@dimen/text_hint"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/nextClassTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/title_ink"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/nextClassTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/accent_strong"
            android:textSize="@dimen/text_hint"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 内容区：课表可竖向滚动，加载/空/错误态覆盖其上。
         始终可见，「铺满一屏」用它的高度算行高（scroll 在空/加载态是 gone，量不到） -->
    <FrameLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:background="@color/tt_border" />

                <com.zhusijiao.app.ui.common.TimetableView
                    android:id="@+id/timetable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:background="@color/tt_border" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/index_loading"
            android:textColor="@color/muted"
            android:textSize="@dimen/text_small"
            android:visibility="gone" />

        <!-- 还没有课表 -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="14dp"
            android:layout_marginTop="56dp"
            android:layout_marginEnd="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">

            <!-- 第一次打开时的欢迎：用应用图标代替卡片框 -->
            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginBottom="18dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher_round" />

            <TextView
                style="@style/EmptyTitle"
                android:text="@string/index_empty_title" />

            <TextView
                android:id="@+id/emptyImport"
                style="@style/PrimaryButton"
                android:layout_marginTop="20dp"
                android:text="@string/index_import" />

            <TextView
                android:id="@+id/emptyJoin"
                style="@style/GhostButton"
                android:layout_marginTop="8dp"
                android:text="@string/join_title" />
        </LinearLayout>

        <!-- 加载失败 -->
        <LinearLayout
            android:id="@+id/errorState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="14dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="36dp"
            android:paddingEnd="16dp"
            android:paddingBottom="36dp"
            android:visibility="gone">

            <TextView
                style="@style/EmptyTitle"
                android:text="@string/index_load_failed_title" />

            <TextView
                android:id="@+id/errorMessage"
                style="@style/EmptyDesc" />

            <TextView
                android:id="@+id/errorRetry"
                style="@style/PrimaryButton"
                android:text="@string/common_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
