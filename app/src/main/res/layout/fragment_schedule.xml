<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.zhusijiao.app.ui.common.AppHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- 周次栏：两侧快捷翻周，中间点击选择周次 -->
    <LinearLayout
        android:id="@+id/weekBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <FrameLayout
            android:id="@+id/prevWeek"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/prevIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:contentDescription="@string/index_prev_week"
                android:src="@drawable/ic_chevron_prev" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/weekCenter"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_menu_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- 与右侧 caret 等宽的占位，保证「第 N 周」文字与下方日期范围同轴居中 -->
                <View
                    android:layout_width="15dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/weekTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/title_ink"
                    android:textSize="15.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginStart="6dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_caret_down" />
            </LinearLayout>

            <TextView
                android:id="@+id/weekCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/tt_week_hint"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/nextWeek"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/nextIcon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:contentDescription="@string/index_next_week"
                android:src="@drawable/ic_chevron_next" />
        </FrameLayout>
    </LinearLayout>

    <!-- 内容区：课表可竖向滚动，加载/空/错误态覆盖其上。
         始终可见，「铺满一屏」用它的高度算行高（scroll 在空/加载态是 gone，量不到） -->
    <FrameLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:background="@color/tt_border" />

                <com.zhusijiao.app.ui.common.TimetableView
                    android:id="@+id/timetable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:background="@color/tt_border" />

                <TextView
                    android:id="@+id/note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingTop="15dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="12dp"
                    android:text="@string/index_unofficial_note"
                    android:textColor="@color/sub_a8"
                    android:textSize="11sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="16dp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <TextView
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/index_loading"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- 还没有课表 -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="14dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="36dp"
            android:paddingEnd="16dp"
            android:paddingBottom="36dp"
            android:visibility="gone">

            <TextView
                style="@style/EmptyTitle"
                android:text="@string/index_empty_title" />

            <TextView
                style="@style/EmptyDesc"
                android:text="@string/index_empty_desc" />

            <TextView
                android:id="@+id/emptyImport"
                style="@style/PrimaryButton"
                android:text="@string/index_import" />

            <TextView
                android:id="@+id/emptyJoin"
                style="@style/GhostButton"
                android:layout_marginTop="8dp"
                android:text="@string/index_use_code" />
        </LinearLayout>

        <!-- 加载失败 -->
        <LinearLayout
            android:id="@+id/errorState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="14dp"
            android:layout_marginTop="36dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="36dp"
            android:paddingEnd="16dp"
            android:paddingBottom="36dp"
            android:visibility="gone">

            <TextView
                style="@style/EmptyTitle"
                android:text="@string/index_load_failed_title" />

            <TextView
                android:id="@+id/errorMessage"
                style="@style/EmptyDesc" />

            <TextView
                android:id="@+id/errorRetry"
                style="@style/PrimaryButton"
                android:text="@string/common_retry" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
