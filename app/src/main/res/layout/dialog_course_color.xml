<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="8dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="13dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/colorPickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:text="@string/color_picker_title"
        android:textColor="@color/heading_ink"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/colorPickerCourse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/sub_8a"
        android:textSize="13sp" />

    <LinearLayout
        android:id="@+id/paletteContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="@string/color_picker_presets"
            android:textColor="@color/field_label"
            android:textSize="12sp"
            android:textStyle="bold" />

        <GridLayout
            android:id="@+id/colorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:columnCount="4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/color_picker_mine"
                android:textColor="@color/field_label"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/addCustomColor"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="2dp"
                android:text="@string/color_picker_add_custom"
                android:textColor="@color/accent_strong"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/customColorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4" />

        <LinearLayout
            android:id="@+id/followDefault"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_menu_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <FrameLayout
                android:id="@+id/followDefaultSwatch"
                android:layout_width="22dp"
                android:layout_height="22dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="@string/color_picker_follow_default"
                android:textColor="@color/body_ink"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/followDefaultCheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓"
                android:textColor="@color/accent_strong"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/customColorEditor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <com.zhusijiao.app.ui.common.ColorComposerView
            android:id="@+id/colorComposer"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:contentDescription="@string/color_picker_custom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <View
                android:id="@+id/customColorPreview"
                android:layout_width="28dp"
                android:layout_height="28dp" />

            <TextView
                android:id="@+id/customColorHex"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:textColor="@color/body_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/customColorCancel"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="2dp"
                android:text="@string/common_cancel"
                android:textColor="@color/sub_68"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/saveCustomColor"
            style="@style/PrimaryButton"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/color_picker_save_custom" />
    </LinearLayout>
</LinearLayout>
