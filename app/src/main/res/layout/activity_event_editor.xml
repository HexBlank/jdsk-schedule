<?xml version="1.0" encoding="utf-8"?>
<!-- 添加 / 编辑日程：名称是唯一要填的，时间和周次已按点的格子给好默认值，想改再点 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.zhusijiao.app.ui.common.AppHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/eventScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="24dp">

            <LinearLayout style="@style/FormGroup">

                <EditText
                    android:id="@+id/eventName"
                    style="@style/FormTitleInput"
                    android:inputType="text"
                    android:importantForAutofill="no"
                    android:hint="@string/event_name_hint"
                    android:imeOptions="actionDone"
                    android:maxLength="40" />
            </LinearLayout>

            <LinearLayout
                style="@style/FormGroup"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:id="@+id/eventTimeRow"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/form_time" />

                    <TextView
                        android:id="@+id/eventTimeValue"
                        style="@style/FormRowValue" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <!-- 整行可点只是放大触摸区；焦点与无障碍交给行内的 ToggleView -->
                <LinearLayout
                    android:id="@+id/eventExactRow"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    tools:ignore="KeyboardInaccessibleWidget">

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/event_exact_label" />

                    <com.zhusijiao.app.ui.common.ToggleView
                        android:id="@+id/eventExactToggle"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/event_exact_label" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/eventClockArea"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <View style="@style/FormDivider" />

                    <LinearLayout
                        android:id="@+id/eventClockRow"
                        style="@style/FormRow"
                        android:clickable="true"
                        android:focusable="true">

                        <TextView
                            android:id="@+id/eventClockValue"
                            style="@style/FormRowLabel"
                            android:layout_width="0dp"
                            android:layout_weight="1" />

                        <TextView style="@style/FormRowChevron" />
                    </LinearLayout>
                </LinearLayout>

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/eventWeeksRow"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/form_weeks" />

                    <TextView
                        android:id="@+id/eventWeeksValue"
                        style="@style/FormRowValue" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/FormGroup"
                android:layout_marginTop="16dp">

                <EditText
                    android:id="@+id/eventPlace"
                    style="@style/FormRowInput"
                    android:importantForAutofill="no"
                    android:hint="@string/event_place_hint"
                    android:maxLength="40" />

                <View style="@style/FormDivider" />

                <EditText
                    android:id="@+id/eventNote"
                    style="@style/FormRowInput"
                    android:importantForAutofill="no"
                    android:hint="@string/event_note_hint"
                    android:inputType="textMultiLine"
                    android:maxLength="200"
                    android:maxLines="4"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:singleLine="false" />

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/eventColorRow"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/event_color_label" />

                    <View
                        android:id="@+id/eventColorSwatch"
                        android:layout_width="22dp"
                        android:layout_height="22dp" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- 只在真的和课重叠时出现一行；有空位时整行可点，直接挪过去 -->
            <TextView
                android:id="@+id/eventAvoid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_menu_row"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp"
                android:textColor="@color/warn"
                android:textSize="@dimen/text_small"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/eventSave"
            style="@style/PrimaryButton"
            android:minHeight="48dp"
            android:text="@string/event_save" />
    </LinearLayout>
</LinearLayout>
