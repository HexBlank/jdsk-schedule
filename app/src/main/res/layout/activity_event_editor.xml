<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.zhusijiao.app.ui.common.AppHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/eventScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="24dp">

            <!-- 实时摘要放最上面：用户从空格子点进来，第一眼要确认的是「在给哪一格加东西」 -->
            <TextView
                android:id="@+id/eventHeadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/accent_strong"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/event_privacy"
                android:textColor="@color/sub_9b"
                android:textSize="11.5sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="6dp"
                android:text="@string/event_name_label"
                android:textColor="@color/field_label"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/eventName"
                style="@style/FieldInput"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:backgroundTint="@null"
                android:hint="@string/event_name_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLength="40"
                android:singleLine="true" />

            <!-- 12 节全部铺开成网格直接点选，不用横滚胶囊行藏住后面的节次 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/event_time_label"
                android:textColor="@color/field_label"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.zhusijiao.app.ui.common.SectionPickerView
                android:id="@+id/eventSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/eventSectionHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="1dp"
                android:textColor="@color/sub_9b"
                android:textSize="11.5sp" />

            <LinearLayout
                android:id="@+id/eventExactRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_menu_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/event_exact_label"
                        android:textColor="@color/body_ink"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/event_exact_desc"
                        android:textColor="@color/sub_9b"
                        android:textSize="11.5sp" />
                </LinearLayout>

                <com.zhusijiao.app.ui.common.ToggleView
                    android:id="@+id/eventExactToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/eventClockArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 点开弹滚轮面板，不在表单里堆四个步进器 -->
                <LinearLayout
                    android:id="@+id/eventClockRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="54dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_field"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:id="@+id/eventClockValue"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/value_ink"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/event_clock_change"
                        android:textColor="@color/accent_strong"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/eventClockNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/sub_9b"
                    android:textSize="11.5sp" />

                <!-- 时间改到别的节次范围时给一条可点的建议，避免「写早上 8 点、块画在晚上」 -->
                <TextView
                    android:id="@+id/eventClockSuggest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_menu_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:lineSpacingExtra="1dp"
                    android:padding="10dp"
                    android:textColor="@color/accent_strong"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/event_repeat_label"
                android:textColor="@color/field_label"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.zhusijiao.app.ui.common.SegmentedChoiceView
                android:id="@+id/eventRepeat"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:id="@+id/eventRepeatEndArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:text="@string/event_repeat_end_label"
                    android:textColor="@color/field_label"
                    android:textSize="12.5sp" />

                <com.zhusijiao.app.ui.common.StepperFieldView
                    android:id="@+id/eventEndWeek"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <TextView
                android:id="@+id/eventRepeatSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/sub_9b"
                android:textSize="11.5sp" />

            <!-- 地点/备注/颜色都不是必填，收起来让主路径只剩「名称 + 节次 + 重复」 -->
            <TextView
                android:id="@+id/eventMoreToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_menu_row"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/event_more_label"
                android:textColor="@color/sub_68"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/eventMoreArea"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/event_place_label"
                    android:textColor="@color/field_label"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/eventPlace"
                    style="@style/FieldInput"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:backgroundTint="@null"
                    android:hint="@string/event_place_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="40"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/event_note_label"
                    android:textColor="@color/field_label"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/eventNote"
                    style="@style/FieldInput"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:backgroundTint="@null"
                    android:hint="@string/event_note_hint"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLength="200"
                    android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="6dp"
                    android:text="@string/event_color_label"
                    android:textColor="@color/field_label"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/eventColorRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_menu_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp">

                    <View
                        android:id="@+id/eventColorSwatch"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/event_color_pick"
                        android:textColor="@color/body_ink"
                        android:textSize="13.5sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/eventAvoid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_menu_row"
                android:clickable="true"
                android:focusable="true"
                android:lineSpacingExtra="2dp"
                android:padding="11dp"
                android:textColor="@color/accent_strong"
                android:textSize="12.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- 保存钉在底部：表单长，不该让用户滚到底才能提交 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <LinearLayout
        android:id="@+id/eventBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingTop="10dp"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/eventSave"
            style="@style/PrimaryButton"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/event_save" />
    </LinearLayout>
</LinearLayout>
