<?xml version="1.0" encoding="utf-8"?>
<!-- 名字和颜色：双方都能改双方，改好后两部手机上都会变 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="8dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="13dp"
        android:background="@drawable/bg_sheet_handle" />

    <TextView
        android:id="@+id/profileTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/heading_ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/couple_profile_sub"
        android:textColor="@color/sub_a8"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_file_info"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/previewBlock"
            android:layout_width="112dp"
            android:layout_height="58dp"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/previewCourse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/couple_profile_preview_course"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/previewRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/couple_profile_preview_room"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/previewSwatch"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/previewName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/title_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/previewHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/FieldLabel"
        android:text="@string/couple_profile_name" />

    <EditText
        android:id="@+id/nameInput"
        style="@style/FieldInput"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="8"
        android:singleLine="true" />

    <TextView
        style="@style/FieldLabel"
        android:text="@string/couple_profile_color" />

    <!-- 8 个预设色 + 自定义，在代码里生成 -->
    <LinearLayout
        android:id="@+id/swatchRow"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/customColor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_menu_row"
        android:clickable="true"
        android:focusable="true"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp"
        android:text="@string/couple_profile_custom"
        android:textColor="@color/accent_strong"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/clashNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/warn"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/profileCancel"
            style="@style/GhostButton"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/common_cancel" />

        <TextView
            android:id="@+id/profileSave"
            style="@style/PrimaryButton"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/couple_profile_save" />
    </LinearLayout>
</LinearLayout>
