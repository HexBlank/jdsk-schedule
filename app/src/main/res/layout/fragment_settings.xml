<?xml version="1.0" encoding="utf-8"?>
<!-- 设置：轻分组标题 + 行首统一矢量图标 + 无描边纯白圆角卡；技术排查项收纳进「高级与诊断」 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.zhusijiao.app.ui.common.AppHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="2dp"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="16dp">

            <!-- ===== 课表 ===== -->
            <TextView
                style="@style/FormGroupTitle"
                android:layout_marginTop="8dp"
                android:text="@string/settings_group_schedule" />

            <LinearLayout style="@style/FormGroup">

                <LinearLayout
                    android:id="@+id/menuAppearance"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/FormRowIcon"
                        android:src="@drawable/ic_menu_appearance" />

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/appearance_title" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View
                    style="@style/FormDivider"
                    android:layout_marginStart="48dp" />

                <LinearLayout
                    android:id="@+id/menuReminder"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/FormRowIcon"
                        android:src="@drawable/ic_bell" />

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/reminder_title" />

                    <TextView
                        android:id="@+id/reminderSub"
                        style="@style/FormRowValue" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View
                    style="@style/FormDivider"
                    android:layout_marginStart="48dp" />

                <LinearLayout
                    android:id="@+id/menuLeave"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/FormRowIcon"
                        android:src="@drawable/ic_menu_leave" />

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/leave_title" />

                    <TextView
                        android:id="@+id/leaveSub"
                        style="@style/FormRowValue" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View
                    style="@style/FormDivider"
                    android:layout_marginStart="48dp" />

                <LinearLayout
                    android:id="@+id/menuCouple"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/FormRowIcon"
                        android:src="@drawable/ic_nav_couple" />

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/settings_couple_row" />

                    <TextView
                        android:id="@+id/coupleSub"
                        style="@style/FormRowValue" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View
                    style="@style/FormDivider"
                    android:layout_marginStart="48dp" />

                <LinearLayout
                    android:id="@+id/menuExport"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/FormRowIcon"
                        android:src="@drawable/ic_menu_export" />

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_export_row" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 应用 ===== -->
            <TextView
                style="@style/FormGroupTitle"
                android:text="@string/settings_group_app" />

            <LinearLayout style="@style/FormGroup">

                <LinearLayout
                    android:id="@+id/updateCheckRow"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/FormRowIcon"
                        android:src="@drawable/ic_update" />

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/settings_update_check" />

                    <TextView
                        android:id="@+id/updateCurrentVersion"
                        style="@style/FormRowValue" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View
                    style="@style/FormDivider"
                    android:layout_marginStart="48dp" />

                <LinearLayout
                    android:id="@+id/updateAutoRow"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    tools:ignore="KeyboardInaccessibleWidget">

                    <ImageView
                        style="@style/FormRowIcon"
                        android:src="@drawable/ic_menu_channel" />

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_update_auto" />

                    <com.zhusijiao.app.ui.common.ToggleView
                        android:id="@+id/updateAutoToggle"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/settings_update_auto" />
                </LinearLayout>

                <View
                    style="@style/FormDivider"
                    android:layout_marginStart="48dp" />

                <!-- 收纳更新通道、服务器地址、同步日志；右侧仍直观呈现服务器连接点与当前地址 -->
                <LinearLayout
                    android:id="@+id/menuAdvanced"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/FormRowIcon"
                        android:src="@drawable/ic_tune" />

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_advanced_row" />

                    <View
                        android:id="@+id/serverStatusDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/sync_dot_gray" />

                    <TextView
                        android:id="@+id/serverSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxWidth="150dp"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_small" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- ===== 关于 ===== -->
            <TextView
                style="@style/FormGroupTitle"
                android:text="@string/settings_about" />

            <LinearLayout style="@style/FormGroup">

                <LinearLayout
                    android:id="@+id/menuQqGroup"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/FormRowIcon"
                        android:src="@drawable/ic_chat" />

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/settings_qq_group" />

                    <TextView
                        style="@style/FormRowValue"
                        android:text="@string/settings_qq_group_number" />
                </LinearLayout>

                <View
                    style="@style/FormDivider"
                    android:layout_marginStart="48dp" />

                <LinearLayout
                    android:id="@+id/menuOpenSource"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/FormRowIcon"
                        android:src="@drawable/ic_code" />

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/settings_open_source" />

                    <TextView
                        style="@style/FormRowValue"
                        android:text="@string/settings_open_source_value" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View
                    style="@style/FormDivider"
                    android:layout_marginStart="48dp" />

                <LinearLayout
                    android:id="@+id/menuSupport"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/FormRowIcon"
                        android:src="@drawable/ic_gift" />

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/support_title" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View
                    style="@style/FormDivider"
                    android:layout_marginStart="48dp" />

                <LinearLayout
                    android:id="@+id/menuPrivacy"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/FormRowIcon"
                        android:src="@drawable/ic_shield" />

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_privacy" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View
                    style="@style/FormDivider"
                    android:layout_marginStart="48dp" />

                <LinearLayout
                    android:id="@+id/menuAbout"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        style="@style/FormRowIcon"
                        android:src="@drawable/ic_info" />

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_about" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/FormGroup"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:id="@+id/menuDelete"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_marginEnd="0dp"
                        android:text="@string/settings_delete_account"
                        android:textColor="@color/danger" />
                </LinearLayout>
            </LinearLayout>

            <!-- 非官方声明：合规要求常驻，压成页脚一行 -->
            <TextView
                android:id="@+id/settingsFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="@color/text_disabled"
                android:textSize="@dimen/text_hint" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
