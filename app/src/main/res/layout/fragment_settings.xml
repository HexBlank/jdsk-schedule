<?xml version="1.0" encoding="utf-8"?>
<!-- 设置：分组列表，行只有「名称 —— 当前值 ›」，不写功能描述 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.zhusijiao.app.ui.common.AppHeader
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="16dp">

            <!-- 常用 -->
            <LinearLayout style="@style/FormGroup">

                <LinearLayout
                    android:id="@+id/menuReminder"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/reminder_title" />

                    <TextView
                        android:id="@+id/reminderSub"
                        style="@style/FormRowValue" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/menuLeave"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/leave_title" />

                    <TextView
                        android:id="@+id/leaveSub"
                        style="@style/FormRowValue" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/menuCouple"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/settings_couple_row" />

                    <TextView
                        android:id="@+id/coupleSub"
                        style="@style/FormRowValue" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/menuAppearance"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_appearance_row" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/menuExport"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_export_row" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- 更新 -->
            <LinearLayout
                style="@style/FormGroup"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:id="@+id/updateCheckRow"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/settings_update_check" />

                    <TextView
                        android:id="@+id/updateCurrentVersion"
                        style="@style/FormRowValue" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <!-- 整行可点只是放大触摸区；焦点与无障碍交给行内的 ToggleView -->
                <LinearLayout
                    android:id="@+id/updateAutoRow"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    tools:ignore="KeyboardInaccessibleWidget">

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_update_auto" />

                    <com.zhusijiao.app.ui.common.ToggleView
                        android:id="@+id/updateAutoToggle"
                        android:layout_width="50dp"
                        android:layout_height="32dp"
                        android:contentDescription="@string/settings_update_auto" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/updateChannelRow"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/settings_channel_row" />

                    <TextView
                        android:id="@+id/updateChannelSub"
                        style="@style/FormRowValue" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <!-- 服务器：值是当前地址，前面的小圆点是连接状态（绿 = 已连接，灰 = 检测中 / 本机模式，红 = 连不上） -->
                <LinearLayout
                    android:id="@+id/menuServer"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_server_row" />

                    <View
                        android:id="@+id/serverStatusDot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/sync_dot_gray" />

                    <TextView
                        android:id="@+id/serverSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxWidth="200dp"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <!-- 关于 -->
            <LinearLayout
                style="@style/FormGroup"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:id="@+id/menuQqGroup"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/settings_qq_group" />

                    <TextView
                        style="@style/FormRowValue"
                        android:text="@string/settings_qq_group_number" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/menuOpenSource"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:text="@string/settings_open_source" />

                    <TextView
                        style="@style/FormRowValue"
                        android:text="@string/settings_open_source_value" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/menuSupport"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/support_title" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/menuSyncLog"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_sync_log" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/menuPrivacy"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_privacy" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>

                <View style="@style/FormDivider" />

                <LinearLayout
                    android:id="@+id/menuAbout"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/settings_about" />

                    <TextView style="@style/FormRowChevron" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/FormGroup"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:id="@+id/menuDelete"
                    style="@style/FormRow"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">

                    <TextView
                        style="@style/FormRowLabel"
                        android:layout_marginEnd="0dp"
                        android:text="@string/settings_delete_account"
                        android:textColor="@color/danger" />
                </LinearLayout>
            </LinearLayout>

            <!-- 非官方声明：合规要求常驻，压成页脚一行 -->
            <TextView
                android:id="@+id/settingsFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="@color/text_disabled"
                android:textSize="@dimen/text_hint" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
