<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="8dp"
    android:paddingEnd="18dp"
    android:paddingBottom="14dp">

    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="13dp"
        android:background="@drawable/bg_sheet_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="14dp">

        <View
            android:id="@+id/eventAccent"
            android:layout_width="4dp"
            android:layout_height="42dp"
            android:layout_marginEnd="11dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/eventDetailTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/heading_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eventDetailSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/sub_8a"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/detail_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="11dp"
        android:paddingBottom="11dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="@string/detail_weeks"
            android:textColor="@color/detail_label"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/eventDetailWeeks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/body_ink"
            android:textSize="13.5sp" />
    </LinearLayout>

    <!-- 时间：自定义时间为主，副行给出它占的节次与该节次的作息，两套口径都交代清楚 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="11dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="@string/detail_time"
            android:textColor="@color/detail_label"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/eventDetailTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/body_ink"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/eventDetailSections"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/sub_9b"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="11dp">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="@string/detail_room"
            android:textColor="@color/detail_label"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/eventDetailPlace"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/body_ink"
            android:textSize="13.5sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/eventDetailNoteRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <TextView
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:text="@string/event_detail_note"
            android:textColor="@color/detail_label"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/eventDetailNote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/body_ink"
            android:textSize="13.5sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/tt_section_bg"
        android:padding="11dp"
        android:text="@string/event_local_only"
        android:textColor="@color/sub_8a"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/eventDetailEdit"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_close_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/event_edit_action"
        android:textColor="@color/sheet_close_text"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/eventDetailDelete"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/event_delete"
        android:textColor="@color/danger_action"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/eventDetailClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="13dp"
        android:paddingBottom="13dp"
        android:text="@string/detail_done"
        android:textColor="@color/sub_8a"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
