<?xml version="1.0" encoding="utf-8"?>
<!-- 大块选项（如「课程 / 日程」二选一）：浅底、按下加深 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_soft" />
            <stroke android:width="1dp" android:color="@color/card_border_active" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/background_alt" />
            <stroke android:width="1dp" android:color="@color/line" />
            <corners android:radius="@dimen/radius_lg" />
        </shape>
    </item>
</selector>
